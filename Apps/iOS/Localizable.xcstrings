    "%1$@ 陪你举铁，待满 30 分钟算一次健身，得 %2$lld 个能量罐。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lifts with you. Stay 30 minutes and it counts as a gym visit: %2$lld cans."
