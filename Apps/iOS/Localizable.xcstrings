      }
    },
    "不切换" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't switch"
          }
        }
      }
    },
    "不切换，用来看你是不是窝在家。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doesn't switch. Used to tell if you're holed up at home."
          }
        }
      }
    },
    "不固定的话，上班只靠到了上班的地方来切，也不发下班提醒。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it varies, Work only switches on when you get to your workplace, and there's no end-of-work reminder."
          }
        }
      }
    },
    "不对" : {
      "comment" : "和后面的“？”拼成 Not right?",
