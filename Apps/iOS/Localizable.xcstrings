    "%@ 从睡觉时间开始变困，一直到起床时间。打开提醒，到点发一条通知，只提醒一次。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gets sleepy from bedtime until wake-up. Turn on the reminder for one notification at bedtime. Just one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は寝る時間から起きる時間まで眠そうにしています。通知をオンにすると、その時間に1回だけ通知します。"
          }
        }
      }
    },
    "%@ 已经在打哈欠了。" : {
      "localizations" : {
        "en" : {
