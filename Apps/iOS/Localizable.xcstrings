    "……这样？" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…Like this?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "……こんな感じ？"
          }
        }
      }
    },
    "……随便看看，不急。" : {
      "comment" : "第二个预设角色",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…just looking. no rush."
