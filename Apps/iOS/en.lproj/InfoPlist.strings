/* Permission prompts. The Chinese base text lives in project.yml. */
"NSLocationWhenInUseUsageDescription" = "Life Hub uses your location to tell whether you have arrived at a place you set, such as work, home or where you work out. It switches mode automatically when you arrive, and uses home to see if you are staying in. Location stays on this iPhone and is never uploaded.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Choosing \"Always\" lets the app notice that you arrived at a place you set even when it is closed. We only check whether you are near those places. We do not record routes, and location never leaves this iPhone.";
"NSHealthShareUsageDescription" = "Life Hub reads only last night's sleep duration, your workouts, recent step count and today's stand hours. It uses them to estimate energy, tell whether you are staying in, celebrate after a workout and nudge you to stretch after sitting. The data is processed on this iPhone and is never uploaded. Only the resulting status is sent to your own Apple Watch.";
"NSMotionUsageDescription" = "Life Hub only checks, on your way between home and work, whether you are walking or riding, so the character can act it out. Motion data stays on this iPhone and is never uploaded.";
